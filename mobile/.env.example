# Public local-development client key only. Never put service_role or secret keys here.
# Copy to .env.local and obtain PUBLISHABLE_KEY from local CLI status privately.
# The native app fixes its API URL to http://127.0.0.1:54321 (Android: USB adb reverse).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-local-publishable-key
